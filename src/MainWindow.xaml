<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AI 工具管理器" Width="1320" Height="900" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen" Background="#F5F6F9" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#1C2638">
<Window.Resources>
 <Style TargetType="Button"><Setter Property="Padding" Value="13,9"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E0E5EE"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#5968D9"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#4659D0"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Padding" Value="12,12"/></Style>
 <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#E0E5EE"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
</Window.Resources>
<Grid x:Name="RootView" Background="#F5F6F9"><Grid.RowDefinitions><RowDefinition Height="57"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Background="White" BorderBrush="#E3E7EE" BorderThickness="0,0,0,1" Padding="22,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#4659D0" CornerRadius="8" Width="32" Height="32"><TextBlock Text="AI" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><TextBlock Text="AI 工具管理器" FontWeight="SemiBold" FontSize="17" VerticalAlignment="Center" Margin="11,0,14,0"/><Border Background="#EDF0FF" Padding="7,3" CornerRadius="4" VerticalAlignment="Center"><TextBlock Text="本地版 1.0" Foreground="#475BD4" FontSize="11"/></Border></StackPanel></Border>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="174"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#F0F2F6" BorderBrush="#E3E7EE" BorderThickness="0,0,1,0"><DockPanel Margin="14,26,14,18"><StackPanel DockPanel.Dock="Top"><TextBlock Text="我的工作台" Foreground="#647087" FontSize="11" Margin="10,0,0,16"/><Button x:Name="LibraryNav" Content="▦   工具总览" Style="{StaticResource Nav}"/><Button x:Name="ChangesNav" Content="↶   最近变化" Style="{StaticResource Nav}"/></StackPanel><StackPanel VerticalAlignment="Bottom"><Button x:Name="Shortcut" Content="▣   创建桌面快捷方式" Style="{StaticResource Nav}" FontSize="11"/><TextBlock Text="●  本地优先 · 只读盘点" Foreground="#25705A" FontSize="11" Margin="8,12,0,5"/><TextBlock Text="不执行工具，不改配置" Foreground="#647087" FontSize="10" Margin="8,0,0,0"/></StackPanel></DockPanel></Border>
<Grid Grid.Column="1" Margin="28,25,28,18"><Grid x:Name="LibraryPage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid><StackPanel><TextBlock x:Name="PageTitle" Text="我的 AI 工具" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="按工具类型整理，点击卡片进入详情，查看用途与使用方法。" Foreground="#647087" Margin="0,7,0,0" FontSize="12"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Button x:Name="Refresh" Content="↻  刷新" Background="#4659D0" Foreground="White" BorderBrush="#4659D0" Margin="0,0,9,0"/><Button x:Name="Manage" Content="＋  管理目录"/><Button x:Name="Cancel" Content="取消" Margin="9,0,0,0" Visibility="Collapsed"/></StackPanel></Grid>
<Border x:Name="NoticeBox" Grid.Row="1" Background="#EAF5F0" CornerRadius="7" Padding="12,10" Margin="0,16,0,0"><DockPanel><Button x:Name="Warnings" Content="扫描提示" DockPanel.Dock="Right" Padding="8,3" FontSize="11" Background="Transparent" BorderThickness="0"/><TextBlock x:Name="Notice" Text="准备进行本地只读盘点…" Foreground="#25705A" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></Border>
<UniformGrid x:Name="CategoryHost" Grid.Row="2" Columns="6" Margin="0,18,0,18"/>
<Grid x:Name="Filters" Grid.Row="3" Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid Margin="0,0,10,0"><TextBox x:Name="Search"/><TextBlock x:Name="SearchHint" Text="搜索工具名称、用途、客户端…" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#8A94A7" IsHitTestVisible="False" FontSize="12"/></Grid><ComboBox x:Name="ClientFilter" Grid.Column="1" Padding="9,7" Margin="0,0,10,0"/><Button x:Name="AllCategories" Grid.Column="2" Content="全部类型"/></Grid>
<Grid Grid.Row="4"><ScrollViewer x:Name="CardScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><DockPanel Margin="0,0,0,12"><TextBlock x:Name="FilteredCount" DockPanel.Dock="Right" Foreground="#647087" FontSize="11" TextAlignment="Right"/><TextBlock x:Name="ListTitle" Text="全部工具" FontWeight="SemiBold"/></DockPanel><WrapPanel x:Name="CardHost"/><TextBlock x:Name="Empty" Text="尚未发现条目，可通过“管理目录”添加工具所在文件夹。" Foreground="#647087" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,60,0,0" Visibility="Collapsed"/></StackPanel></ScrollViewer><ScrollViewer x:Name="ChangeScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ChangeHost"/></ScrollViewer></Grid>
<Grid Grid.Row="5" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Summary" Text="本地盘点 · 未完成首次扫描" FontSize="11" Foreground="#647087" VerticalAlignment="Center" TextWrapping="Wrap"/><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,16,0"><Button x:Name="Prev" Content="‹" Padding="10,4"/><TextBlock x:Name="Pager" Margin="10,0" VerticalAlignment="Center" Foreground="#647087" FontSize="11"/><Button x:Name="Next" Content="›" Padding="10,4"/></StackPanel><CheckBox Grid.Column="2" x:Name="AutoUpdate" Content="自动更新" VerticalAlignment="Center" FontSize="12" IsChecked="True"/></Grid>
</Grid>
<Grid x:Name="DetailPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,20"><Button x:Name="Back" Content="←  返回工具库" DockPanel.Dock="Left"/><TextBlock x:Name="Breadcrumb" Margin="15,0,0,0" VerticalAlignment="Center" Foreground="#647087" FontSize="12" TextWrapping="Wrap"/></DockPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel><Grid Margin="0,0,0,15"><TextBlock Text="功能详情 · 本地资料" FontSize="11" Foreground="#647087"/><TextBlock x:Name="DetailClient" TextAlignment="Right" Foreground="#647087" FontSize="11"/></Grid><Border Background="White" BorderBrush="#E3E7EE" BorderThickness="1" CornerRadius="10"><StackPanel><StackPanel Margin="24"><Border Background="#EDF0FF" CornerRadius="8" Width="38" Height="38" HorizontalAlignment="Left"><TextBlock x:Name="DetailIcon" Text="S" Foreground="#475BD4" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><TextBlock x:Name="DetailTitle" FontSize="26" FontWeight="SemiBold" Margin="0,15,0,7" TextWrapping="Wrap"/><TextBlock x:Name="DetailName" Foreground="#647087" FontSize="12" TextWrapping="Wrap"/><TextBlock x:Name="DetailEvidence" Foreground="#647087" FontSize="12" Margin="0,17,0,0" TextWrapping="Wrap"/></StackPanel><Border BorderBrush="#E3E7EE" BorderThickness="0,1,0,1" Padding="24,0"><StackPanel Orientation="Horizontal"><Button x:Name="GuideTab" Content="功能与使用" BorderThickness="0" Padding="0,13,0,13" Foreground="#475BD4"/><Button x:Name="LocationTab" Content="本地位置" BorderThickness="0" Padding="0,13,0,13" Margin="25,0,0,0"/></StackPanel></Border><Grid Margin="24"><Grid x:Name="GuideBody"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="这个工具能做什么" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock x:Name="Description" Foreground="#536077" FontSize="13" LineHeight="24" TextWrapping="Wrap"/><TextBlock Text="说明来源" FontWeight="SemiBold" FontSize="12" Margin="0,25,0,7"/><TextBlock x:Name="DocSource" Foreground="#647087" FontSize="11" TextWrapping="Wrap"/><Button x:Name="ReadDoc" Content="阅读原始说明" Margin="0,14,0,0" HorizontalAlignment="Left"/><Button x:Name="OpenRepo" Content="打开 GitHub 项目主页" Margin="0,10,0,0" HorizontalAlignment="Left" Visibility="Collapsed"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="如何开始使用" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/><StackPanel x:Name="UsageHost"/><TextBlock Text="文档内容仅作参考，不会自动执行其中的命令。" Foreground="#647087" FontSize="11" Margin="0,20,0,0" TextWrapping="Wrap"/></StackPanel></Grid><StackPanel x:Name="LocationBody" Visibility="Collapsed"><TextBlock Text="准确路径" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBox x:Name="DetailPath" IsReadOnly="True" TextWrapping="Wrap" Background="#F5F6F9"/><StackPanel Orientation="Horizontal" Margin="0,13,0,22"><Button x:Name="Reveal" Content="打开所在文件夹" Margin="0,0,9,0"/><Button x:Name="CopyPath" Content="复制路径"/></StackPanel><TextBlock Text="当前发现情况" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock x:Name="DetailStatus" Foreground="#536077" TextWrapping="Wrap"/><TextBlock x:Name="LocationEvidence" Foreground="#647087" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock Text="只显示发现依据；未测试工具的运行情况。" Foreground="#647087" FontSize="11" Margin="0,20,0,0"/></StackPanel></Grid></StackPanel></Border><TextBlock Text="本地说明以纯文本显示 · 工具管家不会执行工具或更改配置" FontSize="11" Foreground="#647087" Margin="0,15,0,0"/></StackPanel></ScrollViewer></Grid>
</Grid></Grid></Grid></Window>